{
  "name": "sasha-portfolio2",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-hook/window-size": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scroll": "^1.9.3"
  },
  "config": {
    "script_files_glob": "{*.{js,ts},{src,scripts}/**/*.{js,jsx,ts,tsx}}",
    "style_files_glob": "src/**/*.{css,scss}",
    "all_files_glob": "{*.{js,json,yaml,yml,md},{src,scripts}/**/*.{js,jsx,ts,tsx,css,scss,json,yaml,yml,md}}"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.js",
    "preview": "vite preview",
    "prettier:base": "prettier $npm_package_config_all_files_glob",
    "prettier": "npm run prettier:base -- --write"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "vite": "^6.4.5"
  }
}
